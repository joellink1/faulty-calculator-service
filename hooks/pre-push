#!/bin/sh
# Blocks the push if Checkstyle finds violations.
echo "pre-push: running Checkstyle..."
if ! ./mvnw -q checkstyle:check; then
    echo "pre-push: Checkstyle violations found — push aborted."
    echo "Fix them or inspect with: ./mvnw checkstyle:check"
    exit 1
fi
echo "pre-push: Checkstyle OK."
# Blocks the push if Unit Tests finds violations.
echo "pre-push: running Unit Tests..."
if ! java CalculatorControllerTest:check; then
    echo "pre-push: Unit Test failures found - push aborted."
    exit 1
fi
echo "pre-push: Unit tests OK."
